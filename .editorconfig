root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Vendored verbatim from the upstream build. An editor must not reformat it or
# add the final newline it does not have, or the copy stops matching upstream.
[qrcode.js]
insert_final_newline = false
trim_trailing_whitespace = false
